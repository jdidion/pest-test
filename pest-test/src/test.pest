file = ${ SOI ~ test_case ~ ( NEWLINE{2,} ~ test_case )* ~ NEWLINE* ~ EOI }
test_case = !{ test_name ~ code_block ~ expression }
test_name = { (test_identifier ~ colon)? ~ test_title }
test_identifier = @{ absolute_name? ~ ASCII_ALPHA ~ ( ASCII_ALPHANUMERIC | "_" )* }
absolute_name = { "$" }
test_title = @{ ( !NEWLINE ~ ANY )+ }
code_block = ${ PUSH(div) ~ code ~ POP }
div = @{ ( !WHITESPACE ~ ANY ){3,} }
code = @{ ( !PEEK ~ ANY )* }
expression = { skip? ~ lparen ~ identifier ~ ( sub_expressions | ( colon ~ string ) )? ~ rparen }
skip = { lmeta ~ skip_kw ~ lparen ~ depth_kw ~ assign ~ int ~ rparen ~ rmeta }
skip_kw = _{ "skip" }
lmeta = _{ "#[" }
rmeta = _{ "]" }
depth_kw = _{ "depth" }
assign = _{ "=" }
sub_expressions = { expression+ }
lparen = _{ "(" }
rparen = _{ ")" }
identifier = @{ ASCII_ALPHA ~ ( ASCII_ALPHANUMERIC | "_" )* }
colon = _{ ":" }
string = ${ dquote ~ string_value ~ dquote }
dquote = _{ "\"" }
string_value = @{ ( "\\\"" | ( !"\"" ~ ANY ) )* }
int = @{ ASCII_DIGIT+ }
WHITESPACE = _{ ( " " | "\t" | NEWLINE )+ }
